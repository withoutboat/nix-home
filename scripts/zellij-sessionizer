#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 1 ]]; then
    selected="$1"
else
    standalone_dirs=(
        "$HOME/.dotfiles"
        "$HOME/dotfiles"
    )

    search_roots=()

    # Read project roots dynamically generated from secrets by projector
    roots_file="${XDG_CONFIG_HOME:-$HOME/.config}/projector/roots"
    if [[ -r "$roots_file" ]]; then
        while IFS= read -r root || [[ -n "$root" ]]; do
            root="${root#"${root%%[![:space:]]*}"}"
            root="${root%"${root##*[![:space:]]}"}"
            if [[ -n "$root" && -d "$root" ]]; then
                search_roots+=("$root")
            fi
        done < "$roots_file"
    elif command -v projector >/dev/null 2>&1; then
        # Fallback to querying projector roots if available
        while IFS= read -r root || [[ -n "$root" ]]; do
            root="${root#"${root%%[![:space:]]*}"}"
            root="${root%"${root##*[![:space:]]}"}"
            if [[ -n "$root" && -d "$root" ]]; then
                search_roots+=("$root")
            fi
        done < <(projector roots 2>/dev/null || true)
    fi

    search_dirs=()
    for dir in "${search_roots[@]}"; do
        if [[ -d "$dir" ]]; then
            search_dirs+=("$dir")
        fi
    done

    existing_standalone=()
    for dir in "${standalone_dirs[@]}"; do
        if [[ -d "$dir" ]]; then
            existing_standalone+=("$dir")
        fi
    done

    selected=$({
        if [[ ${#existing_standalone[@]} -gt 0 ]]; then
            printf '%s\n' "${existing_standalone[@]}"
        fi
        if [[ ${#search_dirs[@]} -gt 0 ]]; then
            # Include project directories themselves
            printf '%s\n' "${search_dirs[@]}"
            # Include all immediate subdirectories with depth 1
            find "${search_dirs[@]}" -mindepth 1 -maxdepth 1 -type d ! -name ".*" 2>/dev/null
        fi
    } | sort -u | fzf \
        --prompt="PROJECT [NORMAL] > " \
        --header="[NORMAL] j/k: move | i,/: search | Esc: normal | Enter: open | q: quit" \
        --bind "start:disable-search" \
        --bind "ctrl-j:down,ctrl-k:up" \
        --bind "j:down,k:up,q:abort,g:first,G:last" \
        --bind "esc:disable-search+change-prompt(PROJECT [NORMAL] > )+rebind(j,k,q,g,G,i,a,/)" \
        --bind "i:enable-search+change-prompt(PROJECT [INSERT] > )+unbind(j,k,q,g,G,i,a,/)" \
        --bind "a:enable-search+change-prompt(PROJECT [INSERT] > )+unbind(j,k,q,g,G,i,a,/)" \
        --bind "/:enable-search+change-prompt(PROJECT [INSERT] > )+unbind(j,k,q,g,G,i,a,/)" \
        || true)
fi

if [[ -z "${selected:-}" ]]; then
    exit 0
fi

selected=$(cd "$selected" 2>/dev/null && pwd || echo "$selected")
selected="${selected%/}"
selected_name=$(basename "$selected")

if [[ -z "${ZELLIJ:-}" ]]; then
    # Outside Zellij: attach to existing session or create a new one in the selected folder
    cd "$selected"
    exec zellij attach -c "$selected_name"
else
    # Inside Zellij: switch to existing session or create and switch
    if ! zellij list-sessions -n -s 2>/dev/null | grep -Fxq "$selected_name"; then
        (cd "$selected" && zellij attach -b -c "$selected_name")
    fi
    zellij action switch-session "$selected_name"
fi
