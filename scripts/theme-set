#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/current-theme"
mkdir -p "$(dirname "$STATE_FILE")"

THEME="${1:-}"

case "$THEME" in
  light)
    echo "Switching to light theme..."
    if [ -x "/run/current-system/specialisation/light/bin/switch-to-configuration" ]; then
      sudo /run/current-system/specialisation/light/bin/switch-to-configuration test
    else
      echo "Warning: /run/current-system/specialisation/light/bin/switch-to-configuration not found" >&2
    fi

    if [ -x "$HOME/.local/state/nix/profiles/home-manager/specialisation/light/activate" ]; then
      "$HOME/.local/state/nix/profiles/home-manager/specialisation/light/activate"
    elif [ -x "$HOME/.nix-profile/specialisation/light/activate" ]; then
      "$HOME/.nix-profile/specialisation/light/activate"
    fi

    if command -v gsettings >/dev/null 2>&1; then
      gsettings set org.gnome.desktop.interface color-scheme 'prefer-light' || true
    fi

    echo "light" > "$STATE_FILE"
    if command -v notify-send >/dev/null 2>&1; then
      notify-send "Theme" "Switched to light"
    fi
    ;;

  dark|default)
    echo "Switching to dark theme..."
    if [ -x "/run/current-system/bin/switch-to-configuration" ]; then
      sudo /run/current-system/bin/switch-to-configuration test
    else
      echo "Warning: /run/current-system/bin/switch-to-configuration not found" >&2
    fi

    if [ -x "$HOME/.local/state/nix/profiles/home-manager/activate" ]; then
      "$HOME/.local/state/nix/profiles/home-manager/activate"
    elif [ -x "$HOME/.nix-profile/activate" ]; then
      "$HOME/.nix-profile/activate"
    fi

    if command -v gsettings >/dev/null 2>&1; then
      gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true
    fi

    echo "dark" > "$STATE_FILE"
    if command -v notify-send >/dev/null 2>&1; then
      notify-send "Theme" "Switched to dark"
    fi
    ;;

  *)
    echo "Usage: theme-set <light|dark|default>" >&2
    exit 1
    ;;
esac
